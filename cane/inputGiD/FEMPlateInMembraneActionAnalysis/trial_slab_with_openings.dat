 DENSITY,7750
 THERMAL_CONDUCTIVITY,50
 SPECIFIC_HEAT,420

THERMAL_TRANSIENT_ANALYSIS
 SOLVER STEADY_STATE
 TIME_INTEGRATION IMPLICIT_EULER
 START_TIME 0
 END_TIME 10
 NUMBER_OF_TIME_STEPS 100
 ADAPTIVE_TIME_STEPPING true
 
THERMAL_INTEGRATION
 DOMAIN default
 domainNoGP 1
 boundaryNoGP 1

THERMAL_NODES
