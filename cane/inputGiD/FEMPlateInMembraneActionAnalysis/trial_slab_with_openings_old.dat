 SOLVER STEADY_STATE
 TIME_INTEGRATION IMPLICIT_EULER
 START_TIME 0
 END_TIME 10
 NUMBER_OF_TIME_STEPS 100
 ADAPTIVE_TIME_STEPPING true
 
THERMAL_INTEGRATION
 DOMAIN default
 domainNoGP 1
 boundaryNoGP 1

THERMAL_NODES
THERMAL_ELEMENTS
